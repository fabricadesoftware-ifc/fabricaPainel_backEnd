<mjml>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#2196F3" padding="20px 0">
      <mj-column>
        <mj-text align="center" font-size="20px" color="#ffffff" font-weight="bold">
          Convite para Colaboração em Trabalho
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="20px" border-radius="10px">
      <mj-column>
        <mj-text font-size="18px" color="#000000" font-weight="bold">
          Você foi convidado(a) para colaborar em um trabalho!
        </mj-text>

        <mj-text font-size="16px" color="#000000" font-weight="bold">Título do Trabalho:</mj-text>
        <mj-text font-size="16px">{{ work_title }}</mj-text>

        <mj-text font-size="16px" color="#000000" font-weight="bold">Campo do Trabalho:</mj-text>
        <mj-text font-size="16px">{{ work_field }}</mj-text>

        <mj-text font-size="16px" color="#000000" font-weight="bold">Resumo do Trabalho:</mj-text>
        <mj-text font-size="16px">{{ work_abstract }}</mj-text>

        <mj-text font-size="16px" color="#000000" font-weight="bold">Tema Transversal:</mj-text>
        <mj-text font-size="16px">{{ work_cross_cutting_themes }}</mj-text>

        <mj-text font-size="16px" color="#000000" font-weight="bold">Estudantes envolvidos:</mj-text>
        <mj-text font-size="16px">{{ students_emails }}</mj-text>

        <mj-text font-size="16px">Para aceitar esta colaboração, clique no botão abaixo:</mj-text>
        <mj-button background-color="#2196F3" color="#ffffff" href="{{ accept_work_link }}">Aceitar Colaboração</mj-button>

        <mj-text font-size="16px">Caso deseje rejeitar, clique no botão abaixo:</mj-text>
        <mj-button background-color="#d9534f" color="#ffffff" href="{{ reject_work_link }}">Rejeitar Colaboração</mj-button>

      </mj-column>
    </mj-section>

    <mj-section background-color="#2196F3" padding="20px 0">
      <mj-column>
        <mj-text align="center" font-size="14px" color="#ffffff">
          Este é um email automático. Por favor, não responda.<br />
          Caso tenha dúvidas, entre em contato com o suporte.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml> 